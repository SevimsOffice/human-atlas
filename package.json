{
  "name": "human-atlas",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "data:download": "node scripts/download-hubmap.mjs",
    "data:build": "node scripts/build-models.mjs && node scripts/build-manifest.mjs",
    "dev": "npm run dev -w @atlas/web",
    "build": "npm run build -w @atlas/web",
    "preview": "npm run preview -w @atlas/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/physiology && tsc -p packages/anatomy-manifest && tsc -p apps/web",
    "e2e": "playwright test",
    "data:nih-skeleton": "node scripts/build-nih-skeleton.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
